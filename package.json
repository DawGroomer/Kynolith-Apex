{
  "name": "kynolith-lmu-coach",
  "productName": "Kynolith Apex LMU Coach",
  "version": "0.3.1",
  "description": "Real-time Le Mans Ultimate driving coach with live telemetry and conversational voice.",
  "author": "Kynolith LLC",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "tsx --test src/*.test.ts",
    "test:soak": "tsx scripts/soak-telemetry.ts --minutes=60",
    "test:soak:accelerated": "tsx scripts/soak-telemetry.ts --minutes=60 --accelerated",
    "test:local-ai": "tsx scripts/test-local-ai.ts",
    "test:local-voice": "tsx scripts/test-local-voice.ts",
    "reference:convert": "tsx scripts/convert-reference.ts",
    "benchmark:mylmu": "tsx scripts/build-mylmu-benchmark.ts",
    "data:quality": "tsx scripts/migrate-session-quality.ts",
    "models:stage": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-offline-models.ps1",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "build:bridge": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-bridge.ps1",
    "desktop": "electron .",
    "dist:win": "pnpm build:bridge && pnpm build && pnpm validate:packaging && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "build:native": "powershell -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "validate:packaging": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-packaging.ps1",
    "smoke:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-portable.ps1"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.1",
    "@huggingface/transformers": "^3.8.1",
    "express": "^5.1.0",
    "kokoro-js": "1.2.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/ws": "^8.18.1",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "build": {
    "appId": "com.kynolith.apex.lmucoach",
    "productName": "Kynolith Apex LMU Coach",
    "asar": true,
    "compression": "store",
    "directories": {
      "output": "release"
    },
    "icon": "public/assets/ApexLogo.ico",
    "files": [
      "dist/**/*",
      "public/**/*",
      "electron/**/*",
      "config/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "bridge/publish/Kynolith.LmuBridge.exe",
        "to": "bridge/Kynolith.LmuBridge.exe"
      },
      {
        "from": "offline-models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Kynolith-Apex-LMU-Coach-${version}-Beta-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": false,
      "shortcutName": "Kynolith Apex",
      "uninstallDisplayName": "Kynolith Apex",
      "guid": "c3ccacb5-a800-5246-8b4b-d3e78e297f70",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    }
  }
}
